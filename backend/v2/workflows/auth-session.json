      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const result=(status,code,message,request_id='')=>({http_status:status,body:{ok:false,request_id,error:{code,message},meta:{api_version:'2.0',server_time:new Date().toISOString()}}});\nconst rows=$input.all().map(i=>i.json).filter(r=>r.session_id);const s=rows[0];if(rows.length!==1||(!false&&(s.revoked_at||!(Date.parse(s.expires_at)>Date.now()))))return [{json:result(401,'UNAUTHENTICATED','Sesja wygasła lub została zakończona.',$('Validate Input').first().json.request_id)}];return [{json:{valid:true,session:s}}];"
      }
    },

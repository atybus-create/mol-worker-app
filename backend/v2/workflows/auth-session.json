      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const result=(status,code,message,request_id='')=>({http_status:status,body:{ok:false,request_id,error:{code,message},meta:{api_version:'2.0',server_time:new Date().toISOString()}}});\nconst rows=$input.all().map(i=>i.json).filter(r=>r.employee_id);const e=rows[0];if(rows.length!==1||e.active!==true||!['WORKER','LEADER','ADMIN'].includes(e.role))return [{json:result(401,'UNAUTHENTICATED','Konto jest nieaktywne.')}];return [{json:{http_status:200,body:{ok:true,request_id:'',data:{expires_at:$('Check Session').first().json.session.expires_at,user:{employee_id:e.employee_id,display_name:e.display_name,role:e.role}},meta:{api_version:'2.0',server_time:new Date().toISOString()}}}}];"

      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const result=(status,code,message,request_id='')=>({http_status:status,body:{ok:false,request_id,error:{code,message},meta:{api_version:'2.0',server_time:new Date().toISOString()}}});\nconst i=$input.first().json;const authorization=i.headers?.authorization||'';const m=/^Bearer ([0-9a-f]{64})$/.exec(authorization);const request_id=i.body?.request_id||'';if(false&&!/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(request_id))return [{json:result(400,'VALIDATION_ERROR','Nieprawidłowy request_id.')}];return [{json:m?{valid:true,session_token:m[1],request_id}:result(401,'UNAUTHENTICATED','Zaloguj się ponownie.',request_id)}];"
      }

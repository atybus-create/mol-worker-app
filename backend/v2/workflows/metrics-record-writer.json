      "id": "decide-write",
      "name": "Decide Write",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        0
      ],
      "parameters": {
        "jsCode": "const i=$('Validate Record').first().json,rs=$input.all().map(x=>x.json).filter(r=>r[i.key]!==undefined);if(rs.length>1)throw Error('METRICS_DUPLICATE_RECORD');const old=rs[0];const same=old&&Object.entries(i.row).every(([k,v])=>k.endsWith('_at')||k==='source_time'?(v?Date.parse(v):null)===(old[k]?Date.parse(old[k]):null):v===old[k]);if(same)return [{json:{ok:true,skipped:true,verified:true,table:i.table,key:i.row[i.key]}}];if(old&&i.mode==='immutable')throw Error('IMMUTABLE_RECORD_CONFLICT');if(old&&i.mode==='insert_only'){const keys=i.table==='OUTBOX'?['request_id','aggregate_id','type','payload_json']:[i.key];if(keys.some(k=>old[k]!==i.row[k]))throw Error('INSERT_ID_CONFLICT');return [{json:{ok:true,skipped:true,verified:true,table:i.table,key:i.row[i.key]}}];}if(i.expected_version!==undefined&&(old?.version||0)!==i.expected_version)throw Error('METRICS_VERSION_CONFLICT');if(i.expected_status!==undefined&&(old?.status||null)!==i.expected_status)throw Error('METRICS_STATUS_CONFLICT');return [{json:{write:true}}];"
      }
    },

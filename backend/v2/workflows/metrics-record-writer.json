      "parameters": {
        "jsCode": "const i=$input.first().json;const tables={\"ES_POLL_STATE\":[\"XLDbRcZ62PLzCykY\",\"checkpoint_id\"],\"ES_BATCHES\":[\"fj3jJKgoY06BVtu5\",\"batch_id\"],\"PRODUCTION_DELTAS\":[\"GT4Ritsrue5U57NA\",\"delta_id\"],\"NORM_SNAPSHOTS\":[\"4pJlgFine6QhUQxX\",\"summary_id\"],\"STATUS_SNAPSHOTS\":[\"8GZIQBgGlH0dGTAJ\",\"view_id\"],\"DAILY_SUMMARY\":[\"GSpPhENUjWor7bqE\",\"summary_id\"],\"MONTHLY_SUMMARY\":[\"mbmyKatUZSKd4HgX\",\"summary_id\"],\"OUTBOX\":[\"gYdo04L9BIuWc40C\",\"outbox_id\"],\"REPORT_INDEX\":[\"SqNZloUkfNSg1TuG\",\"report_key\"]};if(typeof i.lock_owner!=='string'||!/^\\d+$/.test(i.lock_owner))throw Error('METRICS_LOCK_REQUIRED');const lock_key=i.table==='REPORT_INDEX'?'norm-drive-writer':'command-writer';if(i.noop===true)return [{json:{noop:true,lock_owner:i.lock_owner,lock_key}}];const t=tables[i.table];if(!t||!i.row||Array.isArray(i.row)||typeof i.row[t[1]]!=='string'||!i.row[t[1]]||Object.hasOwn(i.row,'id')||!['immutable','insert_only','replace'].includes(i.mode))throw Error('METRICS_RECORD_INVALID');if(i.table==='PRODUCTION_DELTAS'&&i.mode!=='immutable')throw Error('DELTA_IMMUTABLE');if(i.table==='OUTBOX'&&i.mode!=='insert_only')throw Error('OUTBOX_INSERT_ONLY');return [{json:{...i,table_id:t[0],key:t[1],lock_key}}];"
      }

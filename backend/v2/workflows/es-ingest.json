      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1820,
        220
      ],
      "parameters": {
        "jsCode": "const c=$('Context').first().json,commands=$('Read Pending Commands').all().map(i=>i.json).filter(x=>x.request_id),batches=$('Read Pending Batch').all().map(i=>i.json).filter(x=>x.batch_id),receipts=$('Read Boundary Receipt').all().map(i=>i.json).filter(x=>x.batch_id);if(commands.some(x=>x.request_id!==c.boundary_request_id))return [{json:{ready:false,ok:false,error_code:'ATTENDANCE_RECOVERY_REQUIRED'}}];if(c.origin==='BOUNDARY'&&commands.filter(x=>x.request_id===c.boundary_request_id).length!==1)return [{json:{ready:false,ok:false,error_code:'BOUNDARY_COMMAND_NOT_PREPARED'}}];if(receipts.length>1||batches.length>1)return [{json:{ready:false,ok:false,error_code:'ES_BATCH_INCONSISTENT'}}];if(receipts[0]?.status==='COMMITTED')return [{json:{ready:false,ok:true,replayed:true,batch_id:c.batch_id}}];const old=batches[0];if(!old)return [{json:{ready:true,recovery:false}}];if((c.origin==='BOUNDARY'&&old.batch_id!==c.batch_id)||(c.origin!=='BOUNDARY'&&old.origin==='BOUNDARY'))return [{json:{ready:false,ok:false,error_code:'ES_RECOVERY_REQUIRED'}}];try{const plan=JSON.parse(old.plan_json);if(plan.batch_id!==old.batch_id||plan.schema_version!==1||!Array.isArray(plan.deltas)||!Array.isArray(plan.checkpoints)||!Array.isArray(plan.targets))throw Error('invalid');return [{json:{ready:true,recovery:true,plan,attempts:(old.attempts||1)+1}}];}catch{return [{json:{ready:false,ok:false,error_code:'ES_RECOVERY_PLAN_INVALID'}}];}"

      "parameters": {
        "jsCode": "const config={};for(const x of $('Read Config').all().map(i=>i.json)){if(!x.key||x.key.startsWith('ALLOWED_PROCESSES_'))continue;if(Object.hasOwn(config,x.key))throw Error('CONFIG_DUPLICATE');config[x.key]=JSON.parse(x.value_json);}const i=$('Input').first().json,boundary=i.origin==='BOUNDARY';if(i.lock_owner!==undefined&&!/^\\d+$/.test(String(i.lock_owner)))throw Error('ES_LOCK_INVALID');if(boundary&&(!i.lock_owner||!/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/.test(i.boundary_request_id||'')))throw Error('ES_BOUNDARY_INPUT_INVALID');return [{json:{enabled:config.ES_ENABLED===true||boundary,source_enabled:config.ES_ENABLED===true,lock_owner:String(i.lock_owner||$execution.id),managed:!i.lock_owner,origin:boundary?'BOUNDARY':'SCHEDULE',boundary_request_id:boundary?i.boundary_request_id:null,batch_id:boundary?'ESB-'+i.boundary_request_id:'ES-'+String($execution.id),started_at:new Date().toISOString(),work_date:DateTime.now().setZone('Europe/Warsaw').toISODate()}}];"

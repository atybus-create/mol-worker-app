      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\n\nconst input = $input.first().json;\nconst now = new Date().toISOString();\nconst meta = {api_version:'2.0',server_time:now};\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nconst request_id = uuid.test(input.request_id || '') ? input.request_id : '00000000-0000-4000-8000-' + String($execution.id).padStart(12,'0').slice(-12);\nconst fail = (code,message,status) => [{json:{valid:false,owner:String($execution.id),http_status:status,response:{ok:false,request_id,error:{code,message,retryable:false,details:{}},meta}}}];\nif(!uuid.test(input.request_id || '')) return fail('VALIDATION_ERROR','request_id musi być UUID.',400);\nif(input.operation !== 'CORE_PROBE') return fail('OPERATION_NOT_IMPLEMENTED','Operacja domenowa nie została jeszcze wdrożona.',422);\nif(input.source !== 'SYSTEM_TEST' || input.actor_id !== 'SYSTEM_TEST' || input.employee_id !== 'V2_TEST') return fail('FORBIDDEN','Próba rdzenia wymaga kontekstu SYSTEM_TEST.',403);\nif(!input.payload || typeof input.payload.value !== 'string' || input.payload.value.length>100) return fail('VALIDATION_ERROR','Nieprawidłowy payload próby.',400);\nconst payload_json=JSON.stringify({value:input.payload.value});\nconst canonical=JSON.stringify([input.actor_id,input.employee_id,input.operation,input.source,payload_json]);\nconst response={ok:true,request_id,data:{probe_value:input.payload.value,accepted:true},meta};\nreturn [{json:{valid:true,request_id,owner:String($execution.id),actor_id:input.actor_id,employee_id:input.employee_id,operation:input.operation,source:input.source,payload_json,canonical,response_json:JSON.stringify(response),fault_after_event:input.fault_after_event===true,crash_after_event:input.crash_after_event===true,now,lease_until:new Date(Date.now()+120000).toISOString()}}];\n"
      }

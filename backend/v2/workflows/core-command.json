        "mode": "runOnceForAllItems",
        "jsCode": "\nconst c=$('Hash Command').first().json;\nconst rows=$input.all().map(i=>i.json).filter(r=>r.request_id);\nconst err=(code,message,status,retryable=false)=>[{json:{execute:false,http_status:status,response:{ok:false,request_id:c.request_id,error:{code,message,retryable,details:{}},meta:{api_version:'2.0',server_time:c.now}}}}];\nif(rows.length>1) return err('DUPLICATE_COMMAND','Niespójny rejestr komend.',503);\nconst old=rows[0];\nif(old && old.payload_hash!==c.payload_hash) return err('IDEMPOTENCY_CONFLICT','request_id ma już inną treść.',409);\nif(old?.status==='COMMITTED') return [{json:{execute:false,http_status:200,response:JSON.parse(old.response_json)}}];\nif(old && !['RECEIVED','COMMITTING'].includes(old.status)) return err('RECOVERY_REQUIRED','Komenda wymaga odzyskania.',503,true);\nreturn [{json:{...c,execute:true,attempts:(old?.attempts||0)+1,response_json:old?.response_json||c.response_json}}];\n"

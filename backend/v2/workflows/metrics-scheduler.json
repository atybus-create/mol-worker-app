    {
      "id": "targets",
      "name": "Targets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        220
      ],
      "parameters": {
        "jsCode": "'use strict';\n// Bounded fair rotation. A constant first-six slice can starve all other workers.\nfunction selectTargets(openDays, jobs, now, batchSize=6) {\n if(!Number.isFinite(now)||!Number.isSafeInteger(batchSize)||batchSize<1||batchSize>24)throw Error('SCHEDULER_CONFIG_INVALID');\n const ids=new Set();\n for(const a of openDays)if(a.attendance_id)ids.add(a.attendance_id);\n for(const j of jobs.filter(j=>j.outbox_id&&Date.parse(j.next_attempt_at)<=now).sort((a,b)=>Date.parse(a.createdAt)-Date.parse(b.createdAt)))ids.add(j.aggregate_id);\n const all=[...ids].filter(x=>/^MOL[0-9]+:\\d{4}-\\d{2}-\\d{2}$/.test(x)).sort();\n const start=all.length>batchSize?(Math.floor(now/60000)*batchSize)%all.length:0;\n return Array.from({length:Math.min(batchSize,all.length)},(_,i)=>all[(start+i)%all.length]).map(x=>({employee_id:x.split(':')[0],work_date:x.split(':')[1]}));\n}\nif(typeof module!=='undefined')module.exports={selectTargets};\n\nconst jobs=['Pending Attendance','Retry Attendance','Pending ES','Retry ES'].flatMap(n=>$(n).all().map(x=>x.json));const out=selectTargets($('Open Days').all().map(x=>x.json),jobs,Date.now());return out.length?out.map(json=>({json})):[{json:{noop:true}}];"
      }
    },

      "id": "decision",
      "name": "Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        220
      ],
      "parameters": {
        "jsCode": "const c=$('Context').first().json,j=$('Job').first().json,sources=$('Read Source').all().map(x=>x.json).filter(x=>x[j.source_key]),pubs=$input.all().map(x=>x.json).filter(x=>x.summary_id);if(sources.length!==1||sources[0].status!=='COMMITTED')return [{json:{skip:true,reason:'SOURCE_NOT_COMMITTED'}}];let p;if(c.result==='success'){if(pubs.length!==1||pubs[0].version<c.summary_version)throw Error('ACK_PUBLICATION_NOT_CONFIRMED');p=JSON.parse(pubs[0].payload_json);if(!p.days.some(d=>d.summary_id===j.aggregate_id))throw Error('ACK_DAY_MISSING');}const attempts=(j.attempts||0)+1;const success=c.result==='success',status=success?'DONE':attempts>=8?'DEAD_LETTER':'RETRY_PENDING';return [{json:{success,status,attempts,next_attempt_at:success?j.next_attempt_at:new Date(Date.now()+Math.min(1800000,30000*2**Math.min(attempts,6))).toISOString(),completed_at:success?new Date().toISOString():null,last_error:success?'':String(c.error_code||'METRICS_RECALC_FAILED').slice(0,100)}}];"
      }

      "parameters": {
        "jsCode": "const xs=$input.all().map(x=>x.json).filter(x=>x.outbox_id),j=xs[0];if(xs.length!==1||!['ATTENDANCE_DERIVED','ES_DERIVED'].includes(j.type))return [{json:{skip:true}}];if(['DONE','DEAD_LETTER'].includes(j.status)||Date.parse(j.next_attempt_at)>Date.now())return [{json:{skip:true}}];const c=$('Context').first().json;if(c.aggregate_id!==j.aggregate_id)throw Error('ACK_SCOPE_MISMATCH');return [{json:{...j,source_table:j.type==='ATTENDANCE_DERIVED'?'Oz0NtvJ9SRaVFMc8':'fj3jJKgoY06BVtu5',source_key:j.type==='ATTENDANCE_DERIVED'?'request_id':'batch_id'}}];"

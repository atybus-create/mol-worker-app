    {
      "id": "probe-adapter",
      "name": "Probe Adapter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p=$('Prepare Job').first().json;const attempts=p.row.attempts+1;const failure=p.simulate_failure;const dead=failure&&attempts>=8;return [{json:{outbox_id:p.row.outbox_id,owner:p.owner,status:failure?(dead?'DEAD_LETTER':'RETRY_PENDING'):'COMPLETED',attempts,next_attempt_at:failure&&!dead?new Date(Date.now()+Math.min(3600,Math.pow(2,attempts)*5)*1000).toISOString():null,completed_at:failure?null:new Date().toISOString(),last_error:failure?'SIMULATED_DELIVERY_FAILURE':''}}];"
      }
    },

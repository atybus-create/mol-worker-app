    {
      "id": "prepare-job",
      "name": "Prepare Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input=$('Internal Input').first().json;const rows=$('Read Outbox').all().map(i=>i.json).filter(r=>r.outbox_id);const commands=$input.all().map(i=>i.json).filter(r=>r.request_id);const row=rows[0];let reason='';if(rows.length!==1) reason='OUTBOX_NOT_FOUND_OR_DUPLICATE';else if(row.type!=='CORE_PROBE') reason='ADAPTER_NOT_IMPLEMENTED';else if(commands.length!==1||commands[0].status!=='COMMITTED') reason='COMMAND_NOT_COMMITTED';else if(row.status==='COMPLETED') reason='ALREADY_COMPLETED';else if(!['PENDING','RETRY_PENDING'].includes(row.status)) reason='NOT_READY';else if(new Date(row.next_attempt_at).getTime()>Date.now()) reason='NOT_DUE';return [{json:{execute:!reason,reason,row:row||{},owner:String($execution.id),simulate_failure:input.simulate_failure===true,lease_until:new Date(Date.now()+120000).toISOString()}}];"
      }
    },
    {
      "id": "ready",
      "name": "Ready",
      "type": "n8n-nodes-base.if",

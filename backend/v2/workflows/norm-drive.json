        "jsCode": "const p=$('Build Plan').first().json.plan,chosen=$('Choose Job').first().json;const all=[...$('Read Pending').all().map(x=>x.json),...$('Read Retry').all().map(x=>x.json)].filter(j=>j.outbox_id&&j.type==='NORM_DRIVE'&&j.aggregate_id===p.summary_id&&(()=>{try{return JSON.parse(j.payload_json).version<=p.version;}catch{return false;}})());if(!all.some(j=>j.outbox_id===chosen.outbox_id))throw Error('NORM_JOB_NOT_VERIFIED');return all.map(j=>({json:{outbox_id:j.outbox_id,old_status:j.outbox_id===chosen.outbox_id?'PROCESSING':j.status,attempts:j.attempts+1,expected_owner:j.outbox_id===chosen.outbox_id?String($execution.id):'',summary_id:p.summary_id,version:p.version}}));"

{
  "name": "MOL // APP V2 // CORE ERROR HANDLER",
  "nodes": [
    {
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "sanitize-error",
      "name": "Sanitize Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        250,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$input.first().json;return [{json:{error_id:'exec:'+String(e.execution?.id||$execution.id),request_id:'',workflow_id:String(e.workflow?.id||''),execution_id:String(e.execution?.id||''),code:'WORKFLOW_FAILED',message:'Backend V2: wykonanie nie powiodło się. Sprawdź wskazane execution_id.',occurred_at:new Date().toISOString()}}];"
      }
    },
    {
      "id": "record-error",
      "name": "Record Error",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "alwaysOutputData": true,
      "position": [
        500,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "upsert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "QMyDe52h9QiRlsOp"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "error_id",
              "condition": "eq",
              "keyValue": "={{ $json.error_id }}"
            }
          ]
        },
        "options": {},
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "error_id": "={{ $json.error_id }}",
            "request_id": "={{ $json.request_id }}",
            "workflow_id": "={{ $json.workflow_id }}",
            "execution_id": "={{ $json.execution_id }}",
            "code": "={{ $json.code }}",
            "message": "={{ $json.message }}",
            "occurred_at": "={{ $json.occurred_at }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        }
      }
    },
    {
      "id": "release-failed-writer",
      "name": "Release Failed Writer",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "alwaysOutputData": true,
      "position": [
        750,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "uKfyrOkB2zoSEuBH"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "lock_key",
              "condition": "eq",
              "keyValue": "command-writer"
            },
            {
              "keyName": "owner",
              "condition": "eq",
              "keyValue": "={{ $('Sanitize Error').first().json.execution_id }}"
            }
          ]
        },
        "options": {},
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "owner": "",
            "lease_until": "1970-01-01T00:00:00.000Z"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        }
      }
    },
    {
      "id": "requeue-failed-job",
      "name": "Requeue Failed Job",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "gYdo04L9BIuWc40C"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "lease_owner",
              "condition": "eq",
              "keyValue": "={{ $('Sanitize Error').first().json.execution_id }}"
            },
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "PROCESSING"
            }
          ]
        },
        "options": {},
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "RETRY_PENDING",
            "lease_owner": "",
            "lease_until": "1970-01-01T00:00:00.000Z",
            "next_attempt_at": "={{ $now.plus({seconds:60}).toISO() }}",
            "last_error": "WORKFLOW_FAILED"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        }
      },
      "alwaysOutputData": true
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Sanitize Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sanitize Error": {
      "main": [
        [
          {
            "node": "Record Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record Error": {
      "main": [
        [
          {
            "node": "Release Failed Writer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Release Failed Writer": {
      "main": [
        [
          {
            "node": "Requeue Failed Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "timezone": "Europe/Warsaw",
    "executionOrder": "v1"
  }
}

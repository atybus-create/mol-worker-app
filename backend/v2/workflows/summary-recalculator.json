    {
      "id": "build-input",
      "name": "Build Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        440
      ],
      "parameters": {
        "jsCode": "const c=$('Context').first().json,a=$('Read Attendance').all().map(x=>x.json).filter(x=>x.attendance_id),old=$('Read Month').all().map(x=>x.json).filter(x=>x.summary_id),commands=$('Read Commands').all().map(x=>x.json).filter(x=>x.request_id);if(a.length>1||old.length>1)throw Error('SUMMARY_DUPLICATE');if(commands.some(x=>!['COMMITTED','FAILED'].includes(x.status))||$('Read Pending Batch').all().map(x=>x.json).some(x=>x.batch_id))return [{json:{ok:false,blocked:true,error_code:'SOURCE_RECOVERY_REQUIRED'}}];const cfg={};for(const x of $('Read Config').all().map(x=>x.json))if(x.key&&!x.key.startsWith('ALLOWED_PROCESSES_')){if(Object.hasOwn(cfg,x.key))throw Error('CONFIG_DUPLICATE');cfg[x.key]=JSON.parse(x.value_json);}const effective=a[0]?.state==='OPEN'?DateTime.now().setZone('Europe/Warsaw').toISODate():a[0]?.stop_at?DateTime.fromISO(a[0].stop_at).setZone('Europe/Warsaw').toISODate():c.work_date;const current=c.work_date!==effective;const cps=(current?$('Read Current Checkpoint').all().map(x=>x.json):$('Read Checkpoint').all().map(x=>x.json)).filter(x=>x.checkpoint_id);if(cps.length>1)throw Error('ES_CHECKPOINT_DUPLICATE');const boundaries=$('Read Boundary Commands').all().map(x=>x.json).filter(x=>x.request_id);if(new Set(boundaries.map(x=>x.request_id)).size!==boundaries.length)throw Error('BOUNDARY_COMMAND_DUPLICATE');const sources=[...new Map([...commands,...boundaries].map(x=>[x.request_id,{request_id:x.request_id,status:x.status}])).values()];return [{json:{kind:'SUMMARY',previous_month:old[0]||null,employees:$('Read Employees').all().map(x=>x.json).filter(x=>x.employee_id).map(x=>({employee_id:x.employee_id,active:x.active,es_worker_id:x.es_worker_id})),input:{...c,attendance:a[0]||null,processes:$('Read Processes').all().map(x=>x.json).filter(x=>x.process_session_id),deltas:$('Read Deltas').all().map(x=>x.json).filter(x=>x.delta_id),commands:sources,checkpoint:cps[0]||null,now:new Date().toISOString(),stale_seconds:Number(cfg.ES_STALE_SECONDS)||180}}}];"
      }
    },

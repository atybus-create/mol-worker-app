      "position": [
        780,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const fail=(status,code,message,request_id='')=>({http_status:status,body:{ok:false,request_id,error:{code,message,retryable:status>=500||code==='COMMAND_BUSY'},meta:{api_version:'2.0',server_time:new Date().toISOString()}}});\nconst rows=$input.all().map(i=>i.json).filter(c=>c.request_id&&c.operation?.startsWith('ATTENDANCE_')&&(c.attempts||0)<8&&Date.now()-Date.parse(c.updatedAt)>60000*Math.min(30,2**Math.min(c.attempts||0,5)));rows.sort((a,b)=>Date.parse(a.updatedAt)-Date.parse(b.updatedAt));return rows.slice(0,1).map(c=>({json:{recovery_request_id:c.request_id}}));"
      }
    },
